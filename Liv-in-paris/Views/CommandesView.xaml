<UserControl x:Class="Liv_in_paris.CommandesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="Mes commandes" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

            <ItemsControl ItemsSource="{Binding CommandesClient}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="0 0 0 20">
                            <StackPanel>
                                <!-- Infos commande -->
                                <TextBlock Text="{Binding CommandeId, StringFormat='Commande #{0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding HeureCommande, StringFormat='Date : {0:dd/MM/yyyy HH:mm}'}"/>
                                <TextBlock Text="{Binding PrixTotal, StringFormat='Total : {0} €'}" Margin="0 0 0 10"/>

                                <!-- Liste des lignes commandes -->
                                <TextBlock Text="Détails :" FontWeight="SemiBold" Margin="0 5 0 5"/>
                                <ItemsControl ItemsSource="{Binding Lignes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" BorderBrush="LightGray" CornerRadius="4" Padding="8" Margin="0 0 0 8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Plat.NomPlat}" FontWeight="Bold" FontSize="14"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Plat.PrixParPersonne, StringFormat='Prix : {0:C}'}" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding Plat.NbParts, StringFormat='Parts : {0}'}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AdresseArrivee, StringFormat='Livraison : {0}'}" />
                                                    <TextBlock Text="{Binding HeureLivraison, StringFormat='Heure : {0:dd/MM/yyyy HH:mm}'}" />
                                                    <TextBlock Text="{Binding Statut, StringFormat='Statut : {0}'}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="🗑 Supprimer la commande"
                                        Background="Tomato"
                                        Foreground="White"
                                        Margin="0 10 0 0"
                                        Command="{Binding DataContext.SupprimerCommandeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>