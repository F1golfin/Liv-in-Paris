<Window x:Class="Liv_in_paris.Views.EvaluationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noter le cuisinier" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Note (1 à 5) :" FontWeight="Bold" Grid.Row="0" />
        <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" />

        <TextBlock Text="Commentaire :" FontWeight="Bold" Margin="0,10,0,0" Grid.Row="2"/>
        <TextBox Text="{Binding Commentaire, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Margin="0,30,0,0" AcceptsReturn="True" Height="100"/>

        <Button Content="Envoyer" Grid.Row="3" HorizontalAlignment="Right" Padding="10,5"
                Command="{Binding EnvoyerEvaluationCommand}" Margin="0,20,0,0" />
    </Grid>
</Window>

