<UserControl x:Class="Liv_in_paris.PanierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Liv_in_paris"
             xmlns:vm="clr-namespace:Liv_in_paris"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Votre panier" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Articles dans le panier :" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Panier.Count}" FontSize="16" FontWeight="Normal" Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding Panier}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="LightGray" Padding="10" Margin="5" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding Plat.NomPlat}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Plat.PrixParPersonne, StringFormat='Prix : {0:C}'}" />

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Adresse :" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Text="{Binding AdresseLivraison, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Heure :" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <xctk:DateTimePicker 
                                        Value="{Binding HeureLivraison, UpdateSourceTrigger=PropertyChanged}" 
                                        Format="Custom" 
                                        FormatString="dd/MM/yyyy HH:mm" 
                                        Width="200"
                                        Minimum="{x:Static sys:DateTime.Now}" />
                                </StackPanel>

                                <Button Content="🗑 Retirer"
                                        Margin="0,10,0,0"
                                        Width="100"
                                        Command="{Binding DataContext.RetirerDuPanierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,20,0,0">
                <TextBlock Text="{Binding PrixTotal, StringFormat='Total : {0:C}'}" FontSize="16" FontWeight="Bold" Margin="0,0,20,0"/>
                <Button Content="Passer commande"
                        FontWeight="Bold"
                        Padding="10,5"
                        Background="#2ecc71"
                        Foreground="White"
                        Command="{Binding PasserCommandeCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
