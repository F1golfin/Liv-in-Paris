<UserControl x:Class="Liv_in_paris.Views.ListePlatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Liv_in_paris.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="600">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Plats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0 0 0 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding NomPlat}" FontWeight="Bold"/>
                                    <TextBlock Text="Prix par personne :"/>
                                    <TextBlock Text="{Binding PrixParPersonne}" />
                                    <TextBlock Text="🧂 Ingrédients :" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Recette.Ingredients}" />
                                    <TextBlock Text="Type :" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Recette.Type}" />
                                    <TextBlock Text="Régimes :" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Recette.RegimesNoms, Converter={StaticResource ListeToStringConverter}}" />
                                    <TextBlock Text="Style cuisine :" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Recette.StyleCuisine}" />
                                    <TextBlock Text="Nombre de parts :" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding NbParts}" />
                                    <Button Content="🗑 Supprimer"
                                        Margin="0,10,0,0"
                                        Background="LightCoral"
                                        Command="{Binding DataContext.SupprimerPlatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                </StackPanel>
                                <Image Grid.Column="1" Source="{Binding Image.jpg}"/>
                            </Grid>
                            
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


    </Grid>
</UserControl>
