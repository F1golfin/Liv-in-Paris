<UserControl x:Class="Liv_in_paris.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F0F2F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" Padding="30" Margin="50"
                    CornerRadius="10" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#DDD" BorderThickness="1" >
                <StackPanel>
                    <TextBlock Text="Créer un compte"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0 0 0 20"
                               HorizontalAlignment="Center"/>

                    <!-- Type d'utilisateur -->
                    <TextBlock Text="Type de compte" Margin="0,10,0,2"/>
                    <ComboBox x:Name="UserType"
                              SelectedValue="{Binding SelectedType}"
                              SelectedValuePath="Content"
                              SelectionChanged="ComboBox_SelectionChanged"
                              Margin="0 0 0 10">
                        <ComboBoxItem Content="Particulier"/>
                        <ComboBoxItem Content="Entreprise"/>
                    </ComboBox>

                    <!-- Coordonnées référent -->
                    <TextBlock x:Name="CooReferent" Text="Coordonnées du référent" FontWeight="Bold" Visibility="Collapsed" Margin="0,10,0,5"/>

                    <TextBlock Text="Nom"/>
                    <TextBox Text="{Binding NewNom}" Margin="0 5"/>

                    <TextBlock Text="Prénom"/>
                    <TextBox Text="{Binding NewPrenom}" Margin="0 5"/>

                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding NewEmail}" Margin="0 5"/>

                    <TextBlock Text="Mot de passe"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0 5"/>

                    <TextBlock Text="Confirmer le mot de passe"/>
                    <PasswordBox x:Name="ConfirmBox" Margin="0 5"/>

                    <TextBlock Text="Téléphone"/>
                    <TextBox Text="{Binding NewTelephone}" Margin="0 5"/>

                    <TextBlock Text="Adresse"/>
                    <TextBox Text="{Binding NewAdresse}" Margin="0 5"/>

                    <!-- Informations entreprise -->
                    <TextBlock x:Name="InfoEntreprise" Text="Informations sur l'entreprise" FontWeight="Bold" Margin="0,10,0,5" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtEntreprise" Text="Nom de l'entreprise" Visibility="Collapsed"/>
                    <TextBox x:Name="NomEntreprise" Text="{Binding NewEntreprise}" Margin="0 5" Visibility="Collapsed"/>

                    <!-- Rôles -->
                    <TextBlock Text="Rôles" Margin="0,10,0,2"/>
                    <ListBox x:Name="RoleListBox" SelectionMode="Multiple" Height="60">
                        <ListBoxItem Content="Client" />
                        <ListBoxItem Content="Cuisinier" />
                    </ListBox>

                    <!-- Message d'erreur -->
                    <TextBlock Text="{Binding MessageErreur}" Foreground="Red" Margin="0 10" TextWrapping="Wrap"/>

                    <!-- Boutons -->
                    <Button Content="S'inscrire"
                            Margin="0 5"
                            Padding="8"
                            Click="RegisterButton_Click"
                            Background="#007ACC" Foreground="White"/>

                    <Button Content="Déjà inscrit ? Se connecter"
                            Command="{Binding GoToLoginCommand}"
                            Background="Transparent"
                            Foreground="DarkBlue"
                            BorderBrush="Transparent"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Margin="0,5"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
