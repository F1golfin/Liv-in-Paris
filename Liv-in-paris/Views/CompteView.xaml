<UserControl x:Class="Liv_in_paris.CompteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Liv_in_paris">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="20" Width="400">
        <TextBlock Text="Gestion du compte" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Prénom"/>
        <TextBox Text="{Binding Prenom}" Margin="0,0,0,10"/>

        <TextBlock Text="Nom"/>
        <TextBox Text="{Binding Nom}" Margin="0,0,0,10"/>

        <TextBlock Text="Email"/>
        <TextBox Text="{Binding Email}" Margin="0,0,0,10"/>

        <TextBlock Text="Adresse" />
        <TextBox x:Name="IDAdresse"
                 Text="{Binding AdresseSaisie, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0 5" />
        <ListBox ItemsSource="{Binding Suggestions}"
                 Visibility="{Binding Suggestions.Count, Converter={StaticResource IntToVisibilityConverter}}"
                 SelectionChanged="Suggestions_SelectionChanged"
                 Height="100" />

        <TextBlock Text="Téléphone"/>
        <TextBox Text="{Binding Telephone}" Margin="0,0,0,10"/>

        <!-- Champs entreprise (affiché seulement pour les clients professionnels) -->
        <StackPanel Visibility="{Binding EstEntreprise, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Nom de l'entreprise"/>
            <TextBox Text="{Binding Entreprise}" Margin="0,0,0,10"/>
        </StackPanel>

        <Button Content="Enregistrer"
                Command="{Binding EnregistrerCommand}"
                Padding="8" Width="120" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>