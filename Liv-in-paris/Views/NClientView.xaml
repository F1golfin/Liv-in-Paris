<UserControl x:Class="Liv_in_paris.NClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Liv_in_paris.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <Button x:Name="AccountManager" Content="Gérer votre compte" />
            <ContentControl Content="{Binding PlatsVue}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="5">
            <DockPanel Grid.Row="0" Background="#eee">
                <TextBlock Text="{Binding UtilisateurLabel}" FontWeight="Bold" />
                <Button Content="Déconnexion" DockPanel.Dock="Right" Margin="10 0" Command="{Binding DeconnexionCommand}" />
            </DockPanel>
            <ContentControl Content="{Binding PanierVue}"/>
        </StackPanel>
        <ContentControl Grid.Column="1" Content="{Binding CommandesVue}"/>


    </Grid>
</UserControl>
