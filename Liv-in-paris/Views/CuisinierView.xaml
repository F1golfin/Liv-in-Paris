<UserControl x:Class="Liv_in_paris.CuisinierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Margin="10 0 10 0">
            <TextBlock Text="📦 Mes commandes" FontWeight="Bold" FontSize="16" Margin="0 0 20 10"/>

            <ItemsControl ItemsSource="{Binding Commandes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="DarkGray" BorderThickness="1" Padding="10" Margin="0 0 0 10">
                            <StackPanel>
                                <TextBlock Text="{Binding CommandeId, StringFormat='Commande #{0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding HeureCommande, StringFormat='🕒 Commandée le : {0:dd/MM/yyyy HH:mm}'}"/>

                                <!-- ✅ Affichage des lignes de commande -->
                                <ItemsControl ItemsSource="{Binding LignesCommandes}" Margin="10,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Plat.NomPlat}" Width="150" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding AdresseArrivee}" Width="200" HorizontalAlignment="Left"/>
                                                <ComboBox ItemsSource="{Binding StatutsDisponibles}" HorizontalAlignment="Left"
                                                    SelectedItem="{Binding Statut, Mode=TwoWay}"
                                                    Width="150"/>
                                                <Button Content="✅" HorizontalAlignment="Left" Background="LightGreen" 
                                                    Margin="0,0,0,0"
                                                    Command="{Binding DataContext.MettreAJourStatutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                                
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Itinéraire" Margin="10 0 0 0" Click="Button_Click_2"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        
        <!-- Contenu principal défilable -->
        <StackPanel Margin="20">

            <!-- TITRE -->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="👨‍🍳 Mes plats" x:Name="MesPlats" FontSize="20" FontWeight="Bold" Margin="0 0 0 20" Padding="5 0 5 2" Click="Button_Click"/>
                <Button Grid.Column="1" x:Name="AjouterPlat" Margin="0 0 0 20" Content="➕ Ajouter un plat" FontSize="20" FontWeight="Bold" Padding="5 0 5 2" Click="Button_Click_1"/>
            </Grid>
            <ContentControl x:Name="ContentBox"/>
            <!-- LISTE DES PLATS -->





            <TextBlock Text="📝 Avis reçus" FontWeight="Bold" FontSize="16" Margin="0 0 0 10"/>
            <ItemsControl ItemsSource="{Binding EvaluationsRecues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0 0 0 10">
                            <StackPanel>
                                <TextBlock Text="Note :" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Note}"/>
                                <TextBlock Text="Commentaire :" FontWeight="Bold" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Commentaire}"/>
                                <TextBlock Text="Date :" FontWeight="Bold" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding DateEvaluation}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Bouton de déconnexion -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Se déconnecter"
                    Command="{Binding DeconnexionCommand}"
                    Background="LightGray"
                    Padding="10,5"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
